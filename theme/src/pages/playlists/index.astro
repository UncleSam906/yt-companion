---
import Base from '../../layouts/Base.astro';
import { cfg, getPlaylists, ytThumb } from '../../lib/site.mjs';
const lists = (await getPlaylists()).filter((p) => p.items.length);
---
<Base seo={{ title: 'Playlists', description: `Curated ${cfg.channel.name} video series and playlists.` }}>
  <section class="wrap section">
    <header class="page-head"><h1>Playlists</h1></header>
    <div class="grid-pl">
      {lists.map((p) => (
        <a class="pl-tile" href={`/playlists/${p.id}/`}>
          <img src={p.data.image || ytThumb(p.items[0].data.youtubeId, 'mqdefault')} alt="" width="320" height="180" loading="lazy" />
          <span><strong>{p.data.title}</strong><span class="muted small">{p.items.length} {p.items.length === 1 ? "video" : "videos"}</span>{p.data.description && <span class="small">{p.data.description}</span>}</span>
        </a>
      ))}
    </div>
    {!lists.length && <p class="muted">No playlists yet. Create one with <code>yt-companion add-playlist --title "..."</code></p>}
  </section>
</Base>
