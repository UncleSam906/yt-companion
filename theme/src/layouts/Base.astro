---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cfg } from '../lib/site.mjs';
const { seo = {} } = Astro.props;
const ads = cfg.ads;
---
<!doctype html>
<html lang={cfg.site.language} style={`--accent: ${cfg.site.themeColor}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={cfg.site.themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <Seo {...seo} />
    {cfg.affiliate.headHtml && <Fragment set:html={cfg.affiliate.headHtml} />}
    {import.meta.env.PROD && ads.provider === 'adsense' && ads.adsense.client && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.adsense.client}`} crossorigin="anonymous"></script>
    )}
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
