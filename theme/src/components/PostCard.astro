---
import { formatDate, ytThumb } from '../lib/site.mjs';
interface Props { post: any }
const { post } = Astro.props;
const d = post.data;
const img = d.image || (d.youtubeId ? ytThumb(d.youtubeId, 'mqdefault') : null);
---
<article class="post-card">
  {img && <a href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true"><img src={img} alt="" width="320" height="180" loading="lazy" decoding="async" /></a>}
  <div>
    <h3><a href={`/blog/${post.id}/`}>{d.title}</a></h3>
    <p class="muted small"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
    {d.description && <p>{d.description}</p>}
  </div>
</article>
