---
// Lightweight "facade" embed: renders a thumbnail + play button and only loads the
// youtube-nocookie.com iframe on click. Keeps LCP/CLS excellent and avoids 500KB+ of JS up front.
import { ytThumb, ytWatch } from '../lib/site.mjs';
interface Props { id: string; title: string; start?: number; eager?: boolean }
const { id, title, start = 0, eager = false } = Astro.props;
const params = new URLSearchParams({ autoplay: '1', rel: '0', modestbranding: '1', playsinline: '1' });
if (start) params.set('start', String(start));
const src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
---
<div class="yt" data-yt-src={src} data-yt-title={title} id={`player-${id}`}>
  <a class="yt-facade" href={ytWatch(id)} aria-label={`Play video: ${title}`}>
    <picture>
      <source srcset={ytThumb(id, 'sddefault')} media="(min-width: 640px)" />
      <img src={ytThumb(id, 'hqdefault')} alt="" width="1280" height="720" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" onload="if(this.naturalWidth<=120&&!this.dataset.f){this.dataset.f=1;var s=this.parentNode.querySelector('source');if(s)s.remove();this.src=this.src.replace(/\/[a-z]+default\.jpg/,'/hqdefault.jpg')}" onerror="this.onload()" />
    </picture>
    <span class="yt-play" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7c-.8-2.9-3-5.2-5.9-6C55.3.3 34 .3 34 .3S12.7.3 7.4 1.7c-2.9.8-5.1 3.1-5.9 6C.1 13 .1 24 .1 24s0 11 1.4 16.3c.8 2.9 3 5.2 5.9 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.6-1.4c2.9-.8 5.1-3.1 5.9-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg></span>
  </a>
</div>
<script is:inline>
  (function () {
    if (window.__ytcEmbed) return; window.__ytcEmbed = true;
    function load(box, start) {
      var src = box.dataset.ytSrc;
      if (start != null) src = src.replace(/([?&])start=\d+&?/, '$1') + '&start=' + start;
      var f = document.createElement('iframe');
      f.src = src; f.title = box.dataset.ytTitle; f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true; f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.innerHTML = ''; box.appendChild(f); box.classList.add('is-playing');
    }
    document.addEventListener('click', function (e) {
      var fac = e.target.closest('.yt-facade');
      if (fac) { e.preventDefault(); load(fac.closest('.yt')); return; }
      var ch = e.target.closest('[data-seek]');
      if (ch) {
        var box = document.querySelector('.yt'); if (!box) return;
        e.preventDefault(); load(box, +ch.dataset.seek); box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  })();
</script>
