---
import { cfg, absUrl } from '../lib/site.mjs';
interface Props {
  title?: string; description?: string; image?: string; type?: 'website' | 'article' | 'video.other';
  published?: Date; updated?: Date; tags?: string[]; jsonLd?: object[]; noindex?: boolean;
}
const { title, description: descIn, image, type = 'website', published, updated, tags = [], jsonLd = [], noindex = false } = Astro.props;
const description = descIn || cfg.site.description;
const fullTitle = title ? `${title} | ${cfg.site.title}` : cfg.site.tagline ? `${cfg.site.title} — ${cfg.site.tagline}` : cfg.site.title;
const canonical = absUrl(Astro.url.pathname);
const img = image ? absUrl(image) : cfg.site.defaultImage ? absUrl(cfg.site.defaultImage) : undefined;
const robots = noindex || cfg.seo.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-video-preview:-1';
const keywords = [...new Set([...tags, ...(cfg.seo.keywords || [])])].join(', ');
const twitter = cfg.seo.twitterHandle ? '@' + String(cfg.seo.twitterHandle).replace(/^@/, '') : undefined;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{keywords && <meta name="keywords" content={keywords} />}
{cfg.site.author && <meta name="author" content={cfg.site.author} />}
<meta property="og:site_name" content={cfg.site.title} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title || cfg.site.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{/[-_]/.test(cfg.site.language) && <meta property="og:locale" content={cfg.site.language.replace("-", "_")} />}
{img && <meta property="og:image" content={img} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}
<meta name="twitter:card" content={img ? 'summary_large_image' : 'summary'} />
{twitter && <meta name="twitter:site" content={twitter} />}
<meta name="twitter:title" content={title || cfg.site.title} />
<meta name="twitter:description" content={description} />
{img && <meta name="twitter:image" content={img} />}
<link rel="alternate" type="application/rss+xml" title={`${cfg.site.title} RSS`} href={absUrl('/rss.xml')} />
{!cfg.seo.noindex && <link rel="sitemap" href="/sitemap-index.xml" />}
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
