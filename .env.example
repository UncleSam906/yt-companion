# Template only. Copy to .env for local use (git-ignored):  cp .env.example .env
# Optional. Used only by `yt-companion sync` (src/cli/content.js). Without it, sync
# uses the public RSS feed (last ~15 videos, no key). YOUTUBE_API_KEY is accepted as an alias.
# Restrict the key in Google Cloud Console to the YouTube Data API v3.
YT_API_KEY=
